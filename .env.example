NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL. The Serelix deployment injects these values when the postgres
# service is declared in service.config.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stow
POSTGRES_USER=stow
POSTGRES_PASSWORD=change-me

# Required for production password-reset email delivery.
# Keep the real values in a private deployment .env file.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=username
SMTP_PASSWORD=change-me
SMTP_FROM="STOW <no-reply@example.com>"
